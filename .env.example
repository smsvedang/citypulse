# CityPulse Unified Environment Configuration
# Copy values to Vercel Project Settings > Environment Variables.
# For local development, copy this file to .env.local and replace placeholders.

# Server / runtime
PORT=8080
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
LOG_LEVEL=info

# Firebase / Firestore (Backend)
# Leave FIREBASE_SERVICE_ACCOUNT_B64 blank to use the in-memory fallback store.
FIREBASE_PROJECT_ID=citypulse-31b66
FIREBASE_SERVICE_ACCOUNT_
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# CityPulse demo / feed defaults
DEMO_MODE=false
FEED_MODE_WEATHER=live
FEED_MODE_TRAFFIC=live
FEED_MODE_TRANSIT=live
FEED_INTERVAL_WEATHER_S=300
FEED_INTERVAL_TRAFFIC_S=60
FEED_INTERVAL_TRANSIT_S=60
FEED_TIMEOUT_MS=8000
AUTO_BASELINE=true
CITY_BBOX=26.70,75.55,27.15,76.05
ZONE_MAX_RADIUS_KM=8
MAX_EVENT_AGE_HOURS=24

# AI / Intelligence (Backend Only - Never expose to Frontend)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Email OTP / SMTP
# Required for account email verification flow on Vercel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sonivedang7@gmail.com
SMTP_PASSWORD=eqandyxfnlqbtcrd
SMTP_PASS=eqandyxfnlqbtcrd
SMTP_FROM=sonivedang7@gmail.com

# CLI scripts
API_BASE_URL=https://your-app.vercel.app

