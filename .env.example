# CityPulse Unified Environment Configuration

# Server
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Firebase / Firestore (Backend)
# Leave FIREBASE_SERVICE_ACCOUNT_B64 blank to use in-memory MemoryStore fallback
FIREBASE_PROJECT_ID=citypulse-demo
FIREBASE_SERVICE_ACCOUNT_B64=
FIRESTORE_EMULATOR_HOST=

# CityPulse Demo / Feeds
DEMO_MODE=true
FEED_MODE_WEATHER=synthetic
FEED_MODE_TRAFFIC=synthetic
FEED_MODE_TRANSIT=synthetic
FEED_INTERVAL_WEATHER_S=300
FEED_INTERVAL_TRAFFIC_S=60
FEED_INTERVAL_TRANSIT_S=60
FEED_TIMEOUT_MS=8000
AUTO_BASELINE=true
CITY_BBOX=26.70,75.55,27.15,76.05
ZONE_MAX_RADIUS_KM=8
MAX_EVENT_AGE_HOURS=24

# AI / Intelligence (Backend Only - Never expose to Frontend)
GROQ_API_KEY=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_FIXTURES=false
VITE_USE_EMULATOR=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=citypulse-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
